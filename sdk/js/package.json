{
  "name": "@oxidt/entitle",
  "version": "0.1.0",
  "description": "Client SDK for entitle, the self-hostable RevenueCat alternative: customer info, entitlements, web checkout and purchase sync.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxidt/entitle.git",
    "directory": "sdk/js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "e2e": "bun run e2e/e2e.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
